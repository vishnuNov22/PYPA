# Copy to .env.local and edit. Nothing here is required for a local demo.

# --- Security -------------------------------------------------------------
# Long random string used to sign login cookies and reset links. CHANGE IT in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Public address of the site. Used in the links inside emails.
APP_URL=http://localhost:3000
# Set to 1 only when you run `npm start` over plain http (e.g. on a LAN test). Leave empty behind https.
INSECURE_COOKIES=

# --- Email (optional) -----------------------------------------------------
# Without SMTP_HOST, emails are NOT sent. They are written to Admin > Email log, and the
# screens that trigger them show a preview of the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PYPA Kerala State <no-reply@your-domain.org>"

# --- Behaviour ------------------------------------------------------------
# Largest letter attachment State may upload, in megabytes.
MAX_ATTACH_MB=2
# UPI id shown in the dues QR code. The default is only a placeholder: set the State account.
NEXT_PUBLIC_UPI_ID=pypakerala@upi
# off = hide the "Try a demo account" box on the login page.
PYPA_DEMO=
# off = disable the built-in monthly duplicate check and the 31 Dec age-over run.
PYPA_AUTO_JOBS=
# Bearer token for the cron endpoints (/api/cron/duplicates, /api/cron/age-over).
CRON_SECRET=
# Where the JSON data file lives. Default: ./data/db.json
PYPA_DATA_FILE=
